# ==============================================================================
# CLIMATWIN Backend Environment Template
# DO NOT store real credentials in this file. Copy to .env for local development.
# ==============================================================================

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","*"]

# Firebase / Firestore Setup (Server Admin SDK)
FIREBASE_PROJECT_ID=invest-2-77a18
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# LLM Providers (Server-side only - Never bundle into mobile app)
GOOGLE_API_KEY=placeholder-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# LangSmith Observability & Evaluation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_placeholder_api_key
LANGCHAIN_PROJECT=climatwin-dev

# Redis Cache & Durable State
REDIS_URL=redis://localhost:6379/0

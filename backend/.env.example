# Server Runtime Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","*"]

# Firebase / Firestore Setup (Server Admin SDK)
FIREBASE_PROJECT_ID=climatwin-dev
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# LLM Providers (Server-side only - Never bundle into mobile app)
OPENAI_API_KEY=sk-placeholder-openai-api-key
# ANTHROPIC_API_KEY=sk-ant-placeholder
# GOOGLE_API_KEY=placeholder-gemini-api-key

# LangSmith Observability & Evaluation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_placeholder_api_key
LANGCHAIN_PROJECT=climatwin-dev

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# External Climate & Financial Data Adapters (Optional API Keys)
# NOAA_API_TOKEN=placeholder_token
# NASA_FIRMS_MAP_KEY=placeholder_key
# ALPHA_VANTAGE_API_KEY=placeholder_key
